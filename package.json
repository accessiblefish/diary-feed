{
  "name": "@accessiblefish/diary-feed",
  "version": "0.1.0",
  "description": "A lightweight chronological feed for dated Markdown diaries",
  "main": "main.js",
  "scripts": {
    "dev": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "diary",
    "daily-notes"
  ],
  "author": "accessiblefish",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8"
  },
  "devDependencies": {
    "@sprout2000/esbuild-copy-plugin": "^1.1.14",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
